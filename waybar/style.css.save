@import url("file:///home/l0wer/.cache/wal/colors-waybar.css");

* { font-family: "JetBrainsMono Nerd Font", sans-serif; font-size: 15px; font-weight: bold; border: none; border-radius: 0; min-height: 0;
}

window#waybar { background-color: alpha(@background, 0.85); color: @foreground; border-radius: 12px; margin: 5px 15px;
}

#workspaces { padding: 0; margin: 0; } workspaces button {
    padding: 0 12px; color: @color8; background: transparent; margin: 6px 2px; border-radius: 8px;
}
#workspaces button.active {
    color: @background; background-color: @color4;
}

#window { margin-left: 15px; color: @foreground; font-size: 15px; }

#custom-launcher, #network, #bluetooth, #pulseaudio, #clock, #custom-power, #battery {
    padding: 0 14px; margin: 0 4px;
}

#custom-launcher { color: @color4; font-size: 26px; padding: 0 12px 0 15px; } network { color: @color4; } bluetooth { color: @color4; } pulseaudio { color: @color4; } clock { color: @foreground; 
#font-weight: bold; } custom-power { color: @color1; font-size: 24px; padding-right: 15px; }

